# Copy this file to .env and fill in real values. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEWS_REQUEST_TIMEOUT=15.0
COMPETITOR_REQUEST_TIMEOUT=15.0
MAX_REDIRECTS=3
NUM_ARTICLES=2
MAX_ARTICLES=10
MIN_ARTICLE_CHARS=40
MAX_FEED_BYTES=2000000
MAX_PAGE_BYTES=1000000
MAX_COMPETITOR_CHARS=8000
LLM_REQUEST_TIMEOUT=30.0
LLM_MAX_OUTPUT_TOKENS=512
MAX_RUN_TOKENS=20000
MAX_RUN_LLM_CALLS=24

# Local durable persistence (Docker Compose). Fill in a local-only password and
# use the same value in DATABASE_URL. Never commit .env.
POSTGRES_DB=market_intelligence
POSTGRES_USER=market_intel
POSTGRES_PASSWORD=
# Example shape (no real value is stored here):
# DATABASE_URL=postgresql://market_intel:<local-password>@127.0.0.1:5432/market_intelligence
DATABASE_URL=
# Separate database used only by the Postgres integration tests; the name must
# end in "_test".
# TEST_DATABASE_URL=postgresql://market_intel:<local-password>@127.0.0.1:5432/market_intelligence_test
TEST_DATABASE_URL=
